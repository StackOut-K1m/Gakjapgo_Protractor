# 원본 영상 (용량 큼 — git에 올리지 않음)
data/raw/*.mp4
data/raw/*.mov
data/raw/*.avi
data/raw/*.webm
data/raw/*.mkv

# CSV 전부 — 추출된 좌표(data/landmarks/*.csv 등)는 영상에서 언제든 다시 만든다.
*.csv
# 단, labels.csv 는 예외. "어느 영상이 무슨 자세인가"를 적은 유일한 기록이라
# 이게 없으면 다른 사람이 clone 했을 때 재학습 자체가 불가능하다. 재생성도 안 된다.
!data/raw/labels.csv

# 학습 산출물. train.ipynb 를 돌리면 다시 만들어진다.
#
# ⚠️ 배포에 실제로 쓰이는 정본은 backend/src/main/resources/models/ 에 있고 그쪽은 계속 추적한다.
#    재학습 후 반영하려면 여기 결과물을 그리로 복사해야 한다 (application.yml 의 classpath:models/*).
models/*.json

# 파이썬 캐시
__pycache__/
*.pyc
.ipynb_checkpoints/

#output 테스트들
outputs

models
data
