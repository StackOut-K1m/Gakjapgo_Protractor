# 운영(main) 백엔드 시크릿 — 실제 값 채워 `backend-secrets-prod.env` 로 복사 (chmod 600, 커밋 금지)
# ⚠️ 테스트와 별개 값 권장 (특히 JWT_SECRET, DB_PASSWORD)
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REPORT_S3_BUCKET=
REPORT_S3_REGION=ap-northeast-2

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

MAIL_USERNAME=
MAIL_PASSWORD=

DB_PASSWORD=           # 운영 DB(protractor_prod) 유저 비번
JWT_SECRET=            # 운영 전용 (예: openssl rand -hex 32)
# 참고: OAuth redirect/callback 은 compose backend-prod 의 environment 에서 gakjapgo.site 로 override 됨
