# 테스트(develop) 백엔드 시크릿 — 실제 값 채워 `backend-secrets.env` 로 복사 (chmod 600, 커밋 금지)
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REPORT_S3_BUCKET=
REPORT_S3_REGION=ap-northeast-2

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

MAIL_USERNAME=
MAIL_PASSWORD=          # Gmail 앱 비밀번호

GOOGLE_REDIRECT_URI=https://<도메인>/api/v1/auth/oauth/google/callback
KAKAO_REDIRECT_URI=https://<도메인>/api/v1/auth/oauth/kakao/callback
OAUTH_FRONTEND_CALLBACK_URL=https://<도메인>/oauth/callback

JWT_SECRET=            # 32바이트 이상 (예: openssl rand -hex 32)
