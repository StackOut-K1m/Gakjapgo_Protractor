# docker compose 가 자동 로드하는 .env (실제 값 채워 `.env` 로 복사)
# ⚠️ 실제 .env 는 커밋 금지 (.gitignore)

# --- 인프라 시크릿 ---
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me          # 테스트 DB(protractor) 유저 비번
OPENVIDU_SECRET=change-me         # backend·backend-prod·openvidu 공유

# --- 운영 배포 이미지 태그 (prod-deploy 잡이 세팅) ---
PROD_BACKEND_IMAGE=protractor-backend:prod
PROD_FRONTEND_IMAGE=protractor-frontend:prod

# --- Datadog (docker-compose.datadog.yml 사용 시) ---
DD_API_KEY=change-me
DD_SITE=ap1.datadoghq.com
